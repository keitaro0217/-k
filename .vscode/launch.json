{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "React アプリを起動",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/lawyer-app/src",
      "preLaunchTask": "npm: start - lawyer-app"
    },
    {
      "name": "React アプリにアタッチ（起動済み）",
      "type": "chrome",
      "request": "attach",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/lawyer-app/src"
    }
  ]
}
